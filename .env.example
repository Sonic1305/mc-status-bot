# =====================================================================
#  Minecraft Status-Bot – Einstellungen
#  Diese Datei als ".env" (ohne .example) speichern und ausfüllen.
#  Texte am besten immer in "Anführungszeichen" setzen.
# =====================================================================

# --- Discord ----------------------------------------------------------
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token).
# NIEMALS weitergeben oder in Screenshots zeigen!
DISCORD_TOKEN="HIER_BOT_TOKEN_EINTRAGEN"

# --- Minecraft-Server -------------------------------------------------
# Der Bot läuft auf demselben PC wie der Server -> 127.0.0.1 so lassen.
MC_HOST="127.0.0.1"
# = server-port aus der server.properties
MC_PORT=25565
# = rcon.port und rcon.password aus der server.properties
RCON_PORT=25575
RCON_PASSWORD="HIER_RCON_PASSWORT_EINTRAGEN"

# --- Anzeige ----------------------------------------------------------
SERVER_NAME="TNP Limitless 8"
# Wird als Version angezeigt. Leer lassen = Minecraft-Version vom Server.
VERSION_TEXT="TNP Limitless 8 v1.73.0 (NeoForge 1.21.1)"

# Verbindungsdaten für Radmin VPN. Leer lassen = wird nicht angezeigt.
# Das Passwort nur eintragen, wenn es jeder im Discord sehen darf.
RADMIN_NETWORK=""
RADMIN_PASSWORD=""
# Radmin-IP des Host-PCs plus Port, z. B. "26.12.34.56:25565"
CONNECT_ADDRESS=""

# TPS/Lag anzeigen (nutzt den Befehl "neoforge tps" über RCON)
SHOW_TPS=true

# --- Timing -----------------------------------------------------------
# Wie oft der Server abgefragt wird (Sekunden). Änderungen erscheinen spätestens nach dieser Zeit.
POLL_INTERVAL_SECONDS=15
# Auch ohne Änderung wird die Nachricht so oft neu geschrieben (Lebenszeichen, TPS-Werte).
HEARTBEAT_SECONDS=60
# Nach so vielen fehlgeschlagenen Abfragen hintereinander gilt der Server als offline.
OFFLINE_AFTER_FAILS=3

# --- Meldungen (nur aktiv, wenn per /statusbot alarm ein Channel gesetzt ist) ---
# Lag-Warnung, wenn die TPS so lange unter diesem Wert liegen
TPS_ALERT_THRESHOLD=15
TPS_ALERT_SECONDS=120
# "Server offline"-Meldung erst nach so vielen Minuten Ausfall (0 = sofort).
# Kurze Ausfälle und Neustarts bleiben so ohne Ping.
OFFLINE_ALERT_MINUTES=10
# Für den Tagesrekord (Tageswechsel um Mitternacht)
TIMEZONE="Europe/Berlin"

# --- Neustart per /server neustart --------------------------------------
# Alle Werte haben sinnvolle Standards – fehlen sie in der .env, gilt der Standard.
# Wer den Server neu starten darf: Discord-User-IDs, mit Komma getrennt.
# Leer lassen = nur der Besitzer der Discord-Application (empfohlen).
OWNER_IDS=""
# Name des Startskripts im Serverordner, das den Server nach "stop" neu startet
RESTART_SCRIPT_NAME="start-mit-neustart.bat"
# Warnung, wenn der Server so viele Minuten nach dem Neustart nicht zurück ist
RESTART_TIMEOUT_MINUTES=10
# Mindestabstand zwischen zwei Neustarts
RESTART_COOLDOWN_MINUTES=5

# --- Auto-Update --------------------------------------------------------
# Der Bot prüft regelmäßig auf GitHub, ob es eine neue Version gibt, und installiert sie
# selbst (kurzer Neustart des Bots, der Minecraft-Server läuft weiter).
# false = keine Updates installieren (auch nicht per /server update).
AUTO_UPDATE=true
UPDATE_CHECK_HOURS=6
# Repository für Updates, z. B. "name/mc-status-bot". Leer = Standard aus package.json.
UPDATE_REPO=""
