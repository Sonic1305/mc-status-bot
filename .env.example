# =====================================================================
#  Minecraft Status Bot – settings
#  Save this file as ".env" (without .example) and fill it in.
#  Best put texts in "quotes". Every setting has a default: if a line is
#  missing, the default applies. Restart the bot after changing this file.
# =====================================================================

# --- Discord ----------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
# NEVER share it or show it in screenshots!
DISCORD_TOKEN="YOUR_BOT_TOKEN"

# Language of all bot texts (Discord, in-game announcements, console): en or de.
# Command names are always English (/mc status, /mc server restart, ...).
LANGUAGE="en"

# --- Minecraft server -------------------------------------------------
# The bot runs on the same PC as the server -> keep 127.0.0.1.
MC_HOST="127.0.0.1"
# = server-port from server.properties
MC_PORT=25565
# = rcon.port and rcon.password from server.properties (enable-rcon=true).
# Empty password = status ping only: max. 12 player names, no TPS, no restarts.
RCON_PORT=25575
RCON_PASSWORD="YOUR_RCON_PASSWORD"

# --- Status message ------------------------------------------------------
SERVER_NAME="My Minecraft Server"
# Shown as version. Empty = Minecraft version reported by the server.
VERSION_TEXT=""
# Small image in the top right corner of the status message (https link). Empty = none.
THUMBNAIL_URL=""
# Extra info field, e.g. modpack link or rules. \n = line break. Empty = hidden.
INFO_TEXT=""

# How players connect. Everything empty = the field is hidden.
# Server address, e.g. "play.example.com" or "26.12.34.56:25565"
CONNECT_ADDRESS=""
# Optional VPN (Radmin VPN, ZeroTier, ...): name, network and password.
# Only enter the password if everyone on the Discord server may see it.
VPN_NAME=""
VPN_NETWORK=""
VPN_PASSWORD=""

# Which parts are shown (true/false)
SHOW_PLAYER_LIST=true
# At most this many names are listed (1-100), the rest as "... and N more"
MAX_LISTED_PLAYERS=40
SHOW_TPS=true
SHOW_UPTIME=true
SHOW_VERSION=true
SHOW_RECORDS=true
SHOW_NEXT_RESTART=true
# Message of the day from the server list
SHOW_MOTD=false
# "Updated ... ago" line – reveals when the host PC or bot is off
SHOW_LAST_UPDATED=true
# Player count as the bot's status in the member list
SHOW_PRESENCE=true

# Command for TPS via RCON: auto (tries all), neoforge, forge, paper (also Spigot/Purpur),
# vanilla (also Fabric, "tick query", Minecraft 1.20.3+)
TPS_COMMAND=auto

# --- Timing -----------------------------------------------------------
# How often the server is checked (seconds). Changes appear at the latest after this time.
POLL_INTERVAL_SECONDS=15
# Even without changes the message is rewritten this often (sign of life, TPS values).
HEARTBEAT_SECONDS=60
# After this many failed checks in a row the server counts as offline.
OFFLINE_AFTER_FAILS=3
# Time zone for the daily record and scheduled restarts
TIMEZONE="Europe/Berlin"

# --- Alerts (only active once a channel is set with /mc bot alerts) --------
# Offline / back online (with role ping)
ALERT_OFFLINE=true
# "Offline" alert only after this many minutes of downtime (0 = immediately).
# Short outages and restarts stay without a ping.
OFFLINE_ALERT_MINUTES=10
# New all-time player record
ALERT_RECORDS=true
# Restarts via /mc server restart (scheduled, cancelled, back online). Problems are always reported.
ALERT_RESTARTS=true
# Bot updated itself
ALERT_BOT_UPDATES=true
# Player joined / left
ALERT_JOIN_LEAVE=false

# --- Permissions -----------------------------------------------------------
# Who may restart the server and install bot updates: Discord user IDs, comma-separated.
# Empty = only the owner of the Discord application (recommended).
OWNER_IDS=""
# Roles that may use the admin commands (/mc bot ...), in addition to "Manage Server".
ADMIN_ROLE_IDS=""

# --- Restarts via /mc server restart and schedule ----------------------------
# false = the bot never restarts the server (commands and schedule off).
RESTART_ENABLED=true
# The bot only sends "stop" – something has to start the server again.
# Name of the start script in the server folder that restarts the server after "stop"
# (see server-script/start-with-restart.bat). The bot checks that it is running.
# "none" = a service, Docker or a hosting panel restarts the server; nothing is checked.
RESTART_SCRIPT_NAME="start-with-restart.bat"
# Alert if the server is not back this many minutes after a restart
RESTART_TIMEOUT_MINUTES=10
# Minimum gap between two restarts
RESTART_COOLDOWN_MINUTES=5
# If the server process still runs this long after "stop" (e.g. a mod error while shutting down),
# the bot kills exactly that process – the world has been saved by then. 0 = never. (Windows only)
RESTART_KILL_AFTER_MINUTES=5
# Daily scheduled restarts (time in TIMEZONE), e.g. "04:00" or "04:00,16:00". Empty = off.
# Replaces a restart via the Windows Task Scheduler – don't schedule one there as well.
RESTART_SCHEDULE=""
# The in-game countdown starts this many minutes before (0-30)
RESTART_SCHEDULE_COUNTDOWN_MINUTES=5

# --- Auto-update --------------------------------------------------------
# The bot regularly checks GitHub for a new version and installs it itself
# (short restart of the bot, the Minecraft server keeps running).
# false = never install updates (not even via /mc bot update).
AUTO_UPDATE=true
UPDATE_CHECK_HOURS=6
# Repository for updates, e.g. "name/mc-status-bot". Empty = default from package.json.
UPDATE_REPO=""
